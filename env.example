# Copy this file to .env and fill in your Alpaca PAPER keys.
#   cp .env.example .env && nano .env
# Load it into the shell before running the paper trader:
#   set -a; source .env; set +a
# .env is gitignored -- never commit real keys.

APCA_API_KEY_ID=your_paper_key_id_here
APCA_API_SECRET_KEY=your_paper_secret_here
