# Ship + self-destruct credentials. Copy to ship.env and fill in.
# Load before launching the runner:   set -a; source ship.env; set +a
# ship.env is gitignored -- NEVER commit real tokens/keys.

# DigitalOcean API token with WRITE scope (required to destroy the droplet).
# Create at: https://cloud.digitalocean.com/account/api/tokens
DO_API_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SSH private key that has WRITE (push) access to the repo.
# The GitHub Deploy Key must have "Allow write access" enabled (the clone key
# from setup.sh was read-only). 'origin' must be an SSH remote (git@github.com:...).
DEPLOY_KEY=/home/quant/.ssh/id_deploy

# --- optional overrides ---
# RUN_CMD=python run_search.py
# RESULTS_BRANCH=results-$(date +%Y%m%d-%H%M%S)
# DESTROY_DROPLET=1            # set 0 to rehearse the whole flow without destroying
# VENV=.venv
# GIT_AUTHOR_NAME=droplet-autoscan
# GIT_AUTHOR_EMAIL=droplet@autoscan.local
